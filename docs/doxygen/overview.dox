/**
 * @file overview.dox
 * @brief High-level firmware overview and interaction diagrams.
 */

/**
 * @mainpage ESP32 PhotoFrame Firmware
 *
 * @section overview_overview Overview
 * The firmware is organized around a small set of components that coordinate
 * image rotation, user input, power management, and OTA updates. The main entry
 * point initializes each subsystem, then the runtime loops are driven by
 * button input, HTTP API requests, periodic tasks, or deep-sleep wakeups.
 *
 * @section overview_components Component map
 * - \ref core
 * - \ref power
 * - \ref display
 * - \ref image_processing
 * - \ref storage
 * - \ref network
 * - \ref webapi
 * - \ref config
 * - \ref ota
 * - \ref integration
 * - \ref utils
 *
 * @section overview_interactions Component interactions
 * - Photo updates flow through @ref utils into @ref image_processing, @ref storage, and @ref display.
 * - Sleep decisions are owned by @ref power and referenced from @ref core, @ref webapi, and button handling.
 * - OTA checks are scheduled by @ref core periodic tasks and executed by @ref ota.
 * - Home Assistant notifications in @ref integration are emitted after state changes.
 *
 * @section flow_photo_change Photo change flow
 *
 * @subsection flow_photo_change_sequence Sequence diagram
 * A rotation can start from a timer wake-up, a button press, or the web/API layer.
 * @ref utils decides whether to use local storage or the URL download path, then
 * hands the rendered result to @ref display. Successful changes notify Home
 * Assistant after the display update completes.
 * \msc
 * msc {
 *   Trigger, PowerMgr, Utils, ConfigMgr, Fetcher, ImageProc, Storage, DisplayMgr, HA;
 *   Trigger->PowerMgr [label="reset sleep timer (interactive)"];
 *   Trigger->Utils [label="trigger_image_rotation()"];
 *   Utils->ConfigMgr [label="read rotation mode / schedule"];
 *   Utils->Fetcher [label="URL mode: fetch_and_save_image_from_url()"];
 *   Fetcher->ImageProc [label="decode + dither + persist"];
 *   ImageProc->DisplayMgr [label="display_manager_show_image()"];
 *   Utils->DisplayMgr [label="SD mode: display_manager_rotate_from_storage()"];
 *   DisplayMgr->Storage [label="enumerate albums / read image"];
 *   DisplayMgr->DisplayMgr [label="render + refresh e-paper"];
 *   Utils->HA [label="ha_notify_update()"];
 * }
 * \endmsc
 *
 * The state diagram below shows the decision points that lead to display refresh,
 * including URL fetch failures falling back to local rotation.
 * @subsection flow_photo_change_state State diagram
 * \dot
 * digraph photo_change_state {
 *   rankdir=LR;
 *   node [shape=ellipse];
 *   Idle -> "Select Source";
 *   "Select Source" -> "Fetch Image" [label="URL mode"];
 *   "Select Source" -> "Select Album Image" [label="SD mode"];
 *   "Fetch Image" -> "Process Image";
 *   "Select Album Image" -> "Process Image";
 *   "Process Image" -> "Display Update";
 *   "Display Update" -> Idle;
 *   "Fetch Image" -> "Select Album Image" [label="download failed"];
 * }
 * \enddot
 *
 * @section flow_button_responses Button response flow
 *
 * @subsection flow_button_responses_sequence Sequence diagram
 * The button task polls BOOT/ROTATE/CLEAR inputs with debounce. BOOT only
 * extends the awake window, ROTATE performs a full image change, and CLEAR
 * clears the panel before notifying integrations.
 * \msc
 * msc {
 *   User, ButtonTask, PowerMgr, Utils, DisplayMgr, HA;
 *   User->ButtonTask [label="press BOOT/ROTATE/CLEAR"];
 *   ButtonTask->PowerMgr [label="reset_sleep_timer()"];
 *   ButtonTask->Utils [label="ROTATE: trigger_image_rotation()"];
 *   Utils->DisplayMgr [label="display update"];
 *   ButtonTask->DisplayMgr [label="CLEAR: display_manager_clear()"];
 *   ButtonTask->HA [label="ha_notify_update()"];
 * }
 * \endmsc
 *
 * Wake-from-sleep button handling is routed earlier by @ref power before
 * @ref button_task starts, so the same hardware buttons can either wake the
 * device or act on the running UI depending on the current power state.
 * @subsection flow_button_responses_state State diagram
 * \dot
 * digraph button_state {
 *   rankdir=LR;
 *   node [shape=ellipse];
 *   Idle -> Pressed [label="edge low"];
 *   Pressed -> Action [label="release 50-3000ms"];
 *   Action -> Idle;
 *   Pressed -> Idle [label="ignored/long press"];
 * }
 * \enddot
 *
 * @section flow_deep_sleep Deep sleep flow
 *
 * @subsection flow_deep_sleep_sequence Sequence diagram
 * Power initialization determines the wake source, enables the correct timer
 * and EXT1 wakeups, and keeps the device in automatic light sleep when awake.
 * Entering deep sleep shuts down Wi-Fi, prepares the board, unmounts storage,
 * notifies Home Assistant, and then hands control to the ESP32 sleep engine.
 * \msc
 * msc {
 *   Main, PowerMgr, WiFi, Storage, BoardHAL, HA, Sleep;
 *   Main->PowerMgr [label="power_manager_init()"];
 *   PowerMgr->PowerMgr [label="inspect wake source / timers"];
 *   Main->PowerMgr [label="power_manager_enter_sleep()"];
 *   PowerMgr->HA [label="ha_notify_offline()"];
 *   PowerMgr->WiFi [label="esp_wifi_stop()"];
 *   PowerMgr->BoardHAL [label="prepare_for_sleep()"];
 *   PowerMgr->Storage [label="storage_unmount()"];
 *   PowerMgr->Sleep [label="esp_deep_sleep_start()"];
 *   Sleep->Main [label="wake (timer/button)"];
 *   Main->PowerMgr [label="power_manager_get_wakeup_source()"];
 *   Main->Main [label="app_main()/deep_sleep_wake_main()"];
 * }
 * \endmsc
 *
 * The state diagram mirrors the real boot path: timer wake-ups can jump back to
 * sleep after a rotation, while a BOOT wake resumes the normal network/UI path.
 * @subsection flow_deep_sleep_state State diagram
 * \dot
 * digraph deep_sleep_state {
 *   rankdir=LR;
 *   node [shape=ellipse];
 *   Awake -> "Auto-sleep timer" [label="idle on battery"];
 *   "Auto-sleep timer" -> "Entering sleep" [label="timeout or /api/sleep"];
 *   "Entering sleep" -> "Deep sleep";
 *   "Deep sleep" -> "Wake init" [label="timer/button"];
 *   "Wake init" -> "Deep-sleep wake flow" [label="timer/rotate"];
 *   "Wake init" -> Awake [label="boot button/cold boot"];
 *   "Deep-sleep wake flow" -> "Entering sleep" [label="rotation complete"];
 * }
 * \enddot
 *
 * @section flow_ota OTA flow
 *
 * @subsection flow_ota_sequence Sequence diagram
 * OTA is checked by a periodic task, stored in NVS for persistence, and only
 * started when a newer release is available. During download the sleep timer is
 * kept alive, the image is validated, and the firmware reboots after success.
 * \msc
 * msc {
 *   PeriodicTasks, OtaMgr, HttpClient, PowerMgr, Flash, NVS, HA, System;
 *   PeriodicTasks->OtaMgr [label="ota_check_for_update()"];
 *   OtaMgr->HttpClient [label="fetch GitHub release info"];
 *   OtaMgr->NVS [label="persist latest version / state"];
 *   PeriodicTasks->OtaMgr [label="ota_start_update()"];
 *   OtaMgr->PowerMgr [label="reset_sleep_timer()"];
 *   OtaMgr->HttpClient [label="download firmware"];
 *   OtaMgr->Flash [label="write + validate"];
 *   OtaMgr->HA [label="ha_notify_update()"];
 *   OtaMgr->System [label="esp_restart()"];
 * }
 * \endmsc
 *
 * The state diagram below matches the manager's persisted states: checking,
 * update available, downloading, installing, success, and error.
 * @subsection flow_ota_state State diagram
 * \dot
 * digraph ota_state {
 *   rankdir=LR;
 *   node [shape=box];
 *   Idle -> Checking;
 *   Checking -> UpdateAvailable [label="new version"];
 *   Checking -> Idle [label="up to date"];
 *   Checking -> Error [label="fetch failed"];
 *   UpdateAvailable -> Downloading [label="ota_start_update()"];
 *   Downloading -> Installing;
 *   Installing -> Success;
 *   Downloading -> Error;
 *   Installing -> Error;
 *   Success -> Reboot;
 *   Error -> Idle [label="retry later"];
 * }
 * \enddot
 */
